# ─────────────────────────────────────────────────────────────────────────────
# RABS Flooring — environment
# Copy to .env.local for development. Set the same keys in Vercel for deploys.
# Full explanation: docs/LAUNCH.md
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin. No trailing slash.
# Drives canonicals, OG URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# INDEXING — leave unset (or anything other than "true") for the pitch build.
# While this is not "true", three independent layers block search engines:
# the X-Robots-Tag header, robots.txt, and per-page robots metadata.
# Set to "true" only when the production domain goes live.
# NEXT_PUBLIC_INDEXABLE=true

# PITCH MODE — "false" removes the concept banner and every piece of example
# content (sample projects and their "Layout example" tags). Any other value
# leaves pitch mode on.
NEXT_PUBLIC_PITCH_MODE=true

# ── Enquiry email ────────────────────────────────────────────────────────────
# Server-side only; never reaches the browser.
# Without these the quote form still validates, rate-limits and succeeds — it
# logs the enquiry to the server console instead of sending it. That is what
# makes the whole journey testable on the pitch build.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ENQUIRY_TO_EMAIL=enquiries@rabsflooring.co.uk
# ENQUIRY_FROM_EMAIL=website@rabsflooring.co.uk

# ── Analytics ────────────────────────────────────────────────────────────────
# GA4 measurement ID. Without it, events log to the console in development.
# Nothing fires before the visitor accepts analytics cookies either way.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Spam protection (optional) ───────────────────────────────────────────────
# Without these the honeypot and the per-IP rate limiter still apply.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
# TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000
